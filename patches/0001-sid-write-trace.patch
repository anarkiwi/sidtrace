diff --git a/src/sidtrace.h b/src/sidtrace.h
new file mode 100644
index 0000000..b1affe8
--- /dev/null
+++ b/src/sidtrace.h
@@ -0,0 +1,167 @@
+/*
+ * This file is part of libsidplayfp, a SID player engine.
+ *
+ * SID write tracer: streams a zstd-compressed CSV of every SID register
+ * write that changes a register, annotated with cycle counts.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef SIDTRACE_H
+#define SIDTRACE_H
+
+#include "Event.h" // event_clock_t
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <zstd.h>
+
+namespace libsidplayfp
+{
+
+/**
+ * Streams a zstd-compressed CSV log of SID register writes.
+ *
+ * Columns: cycle,cycle_since_nmi,cycle_since_video_irq,cycle_since_cia_irq,chip,reg,value
+ *   cycle                  - PHI1 cycles since the last C64 reset ("boot")
+ *   cycle_since_nmi        - cycles since the last NMI was raised (empty if none)
+ *   cycle_since_video_irq  - cycles since the last VIC (raster) IRQ (empty if none)
+ *   cycle_since_cia_irq    - cycles since the last CIA (timer) IRQ (empty if none)
+ *   chip                   - SID index (0 = base $D400, 1 = second SID, ...)
+ *   reg                    - register offset 0..31
+ *   value                  - byte written
+ *
+ * Header-only so the fork adds no source-list changes to the build.
+ */
+class SidTrace
+{
+public:
+    /// Interrupt sources tracked for the delta columns.
+    enum interrupt_t { NMI = 0, VIDEO_IRQ = 1, CIA_IRQ = 2, NUM_INTERRUPTS = 3 };
+
+private:
+    static const size_t FLUSH_THRESHOLD = 1u << 16;
+
+    FILE *m_fp = nullptr;
+    ZSTD_CCtx *m_cctx = nullptr;
+    std::vector<char> m_outbuf;
+    std::string m_raw;
+
+    event_clock_t m_last[NUM_INTERRUPTS] = {0, 0, 0};
+    bool m_have[NUM_INTERRUPTS] = {false, false, false};
+    bool m_ok = false;
+
+    void compress(bool end)
+    {
+        if (!m_ok)
+            return;
+
+        ZSTD_inBuffer in { m_raw.data(), m_raw.size(), 0 };
+        const ZSTD_EndDirective mode = end ? ZSTD_e_end : ZSTD_e_continue;
+        for (;;)
+        {
+            ZSTD_outBuffer out { m_outbuf.data(), m_outbuf.size(), 0 };
+            const size_t rem = ZSTD_compressStream2(m_cctx, &out, &in, mode);
+            if (ZSTD_isError(rem))
+            {
+                m_ok = false;
+                return;
+            }
+            if (out.pos != 0)
+                std::fwrite(m_outbuf.data(), 1, out.pos, m_fp);
+            if (end ? (rem == 0) : (in.pos == in.size))
+                break;
+        }
+        m_raw.clear();
+    }
+
+public:
+    explicit SidTrace(const char *path) :
+        m_outbuf(ZSTD_CStreamOutSize())
+    {
+        m_fp = std::fopen(path, "wb");
+        if (m_fp == nullptr)
+            return;
+
+        m_cctx = ZSTD_createCCtx();
+        if (m_cctx == nullptr)
+        {
+            std::fclose(m_fp);
+            m_fp = nullptr;
+            return;
+        }
+
+        ZSTD_CCtx_setParameter(m_cctx, ZSTD_c_compressionLevel, 3);
+        m_ok = true;
+        m_raw = "cycle,cycle_since_nmi,cycle_since_video_irq,cycle_since_cia_irq,chip,reg,value\n";
+    }
+
+    ~SidTrace()
+    {
+        if (m_ok)
+            compress(true);
+        if (m_cctx != nullptr)
+            ZSTD_freeCCtx(m_cctx);
+        if (m_fp != nullptr)
+            std::fclose(m_fp);
+    }
+
+    SidTrace(const SidTrace &) = delete;
+    SidTrace &operator=(const SidTrace &) = delete;
+
+    bool ok() const { return m_ok; }
+
+    /// Record the cycle at which an interrupt line was raised.
+    void markInterrupt(interrupt_t kind, event_clock_t cycle)
+    {
+        m_last[kind] = cycle;
+        m_have[kind] = true;
+    }
+
+    /// Clear interrupt history (called on C64 reset).
+    void resetInterrupts()
+    {
+        for (int i = 0; i < NUM_INTERRUPTS; ++i)
+        {
+            m_last[i] = 0;
+            m_have[i] = false;
+        }
+    }
+
+    /// Append a CSV row for a register-changing write.
+    void write(int chip, event_clock_t cycle, uint8_t reg, uint8_t value)
+    {
+        if (!m_ok)
+            return;
+
+        char delta[NUM_INTERRUPTS][24];
+        for (int i = 0; i < NUM_INTERRUPTS; ++i)
+        {
+            if (m_have[i])
+                std::snprintf(delta[i], sizeof(delta[i]), "%lld",
+                    static_cast<long long>(cycle - m_last[i]));
+            else
+                delta[i][0] = '\0';
+        }
+
+        char buf[128];
+        const int n = std::snprintf(buf, sizeof(buf), "%lld,%s,%s,%s,%d,%u,%u\n",
+            static_cast<long long>(cycle), delta[NMI], delta[VIDEO_IRQ], delta[CIA_IRQ],
+            chip, static_cast<unsigned>(reg), static_cast<unsigned>(value));
+        m_raw.append(buf, n);
+
+        if (m_raw.size() >= FLUSH_THRESHOLD)
+            compress(false);
+    }
+};
+
+}
+
+#endif // SIDTRACE_H
